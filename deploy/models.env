# The three model repos and the commit each is pinned to. GET /models reads
# this file, and the api image carries a copy.
#
# This is not the only copy of the pins. The cutout and art services hold theirs
# as Python constants, and docker-compose.yml holds vLLM's as the defaults of its
# command, because that is where each is used. tests/unit/test_deploy_models.py
# asserts all three agree with this file.

# BiRefNet. Loaded with trust_remote_code=True, which is why the revision is
# pinned rather than tracking main.
CUTOUT_MODEL=ZhengPeng7/BiRefNet
CUTOUT_REVISION=e2bf8e4460fc8fa32bba5ea4d94b3233d367b0e4
CUTOUT_LICENSE=MIT

# FLUX.2 [klein] 4B. 16 GB in the folders the pipeline reads.
ART_MODEL=black-forest-labs/FLUX.2-klein-4B
ART_REVISION=e7b7dc27f91deacad38e78976d1f2b499d76a294
ART_LICENSE=Apache-2.0

# Gemma 4 12B, QAT w4a16 compressed-tensors. 9.55 GiB of weights, which is what
# makes it fit a 20 GB card next to a KV cache. The bf16 checkpoint is about
# 24 GB and does not fit at all.
LLM_MODEL=google/gemma-4-12B-it-qat-w4a16-ct
LLM_REVISION=1d2c2d7f2466070e69d6fb3fd5ce9a7d75f2f6ee
LLM_LICENSE=Apache-2.0
