# GPU_COUNT=1, the default. g2-gpu-rtx4000a1-m: one 20 GB RTX 4000 Ada and
# 32 GB of RAM. Every model on card 0, and FLUX's weights in RAM.
#
# Sized on paper and not yet measured on a node. docker-compose.yml has the
# numbers, above the gpu profile, and its defaults are this file.
#
# deploy.sh copies these lines into the node's .env.
ART_GPU=0
CUTOUT_GPU=0
LLM_GPU=0
LLM_RAN_ON=akamai-gpu0
LLM_GPU_MEMORY=0.65
ART_CPU_OFFLOAD=1
