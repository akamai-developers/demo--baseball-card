# GPU_COUNT=2. g2-gpu-rtx4000a2-s: two 20 GB RTX 4000 Ada cards. FLUX on card 0
# by itself, vLLM and BiRefNet on card 1.
#
# Measured with these settings in September and October 2026.
# docker-compose.yml has the numbers, above the gpu profile.
#
# deploy.sh copies these lines into the node's .env.
ART_GPU=0
CUTOUT_GPU=1
LLM_GPU=1
LLM_RAN_ON=akamai-gpu1
LLM_GPU_MEMORY=0.80
ART_CPU_OFFLOAD=0
