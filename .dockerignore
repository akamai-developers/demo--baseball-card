# Keep secrets, state and outputs out of every build context.
.env
.env.*
secrets/
*.tfstate
*.tfstate.*
*.tfvars
.terraform/

.git/
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
out/
build-logs/
# The api image downloads its own copy and checks it against web/vendor.lock.
web/vendor/
docs/
tests/
BUILD_PROGRESS.md
PROMPT.md
build.sh
CLAUDE.md
.claude/
