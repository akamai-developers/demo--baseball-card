# Copied to .env by `make env` and `make up-mock`. .env is gitignored.
#
# Block 1 is what you set. Block 2 is defaults: leave them. Block 3 says what
# the node's own .env holds.

# ============================================================================
# 1. What you set
# ============================================================================

# Mock mode on a laptop: nothing to set. `make up-mock` fills in CARD_API_KEY.

# The one API key. Every service checks it, vLLM included. `make env` makes it
# with openssl rand -hex 32.
CARD_API_KEY=

# The gateway's port on this machine. The mock stack binds it on 127.0.0.1,
# and make tunnel forwards it to the node, so one of the two is here at a time.
# Change it when 8443 is taken.
GATEWAY_PORT=8443

# ---- Akamai Cloud -----------------------------------------------------------
# LINODE_TOKEN goes in your shell, not here: export LINODE_TOKEN=...

# 1 lets make deploy, rotate-key and destroy create, change and delete the
# resources tagged baseball-card. make gpu-check only reads, and runs without it.
ALLOW_CLOUD_DEPLOY=0

# How many GPUs the node has. 1 is g2-gpu-rtx4000a1-m: one 20 GB RTX 4000 Ada
# and 32 GB of RAM, and the three models share the card. 2 is
# g2-gpu-rtx4000a2-s: two cards, FLUX on one, Gemma and BiRefNet on the other.
GPU_COUNT=1

# Optional. Another RTX 4000 Ada plan with GPU_COUNT cards. Empty is the plan
# GPU_COUNT picks.
LINODE_TYPE=

# The region the node goes in. make gpu-check lists the regions that can sell
# the plan right now.
LINODE_REGION=us-ord

# Optional. The addresses allowed on port 22, as IPv4 CIDR blocks separated by
# commas: the machine that runs make deploy, and any other you will ssh or
# tunnel from, for example 203.0.113.4/32,198.51.100.7/32. Empty means make
# deploy asks whatismyip.akamai.com and uses the answer as a /32. Pin it if
# your address changes, as behind some VPNs. One block has to hold the machine
# running make deploy, since that is where the ssh comes from, and make deploy
# stops before Terraform when none does.
ADMIN_CIDR=

# Optional. Empty is tunnel mode: only SSH is open, and the gateway is reached
# through an SSH tunnel. A hostname opens 80 and 443 so Caddy can get a Let's
# Encrypt certificate for it. Point its DNS A record at the node first.
DOMAIN=

# Optional. Only for a gated model repo. The pinned models are not gated.
# make deploy sends the node this one, never an HF_TOKEN from your shell.
HF_TOKEN=

# ============================================================================
# 2. Defaults. Nothing below needs a change to run the demo.
# ============================================================================

# How long a card and its photo stay on the node, in hours, and how often the
# sweeper looks for older ones, in seconds.
RETENTION_HOURS=24
SWEEP_EVERY_S=900

# Seconds one pipeline step may take, and the background painting.
STEP_TIMEOUT_S=180
ART_TIMEOUT_S=120

# The largest photo the api takes, in MB, and the long side it is scaled to.
MAX_UPLOAD_MB=15
MAX_PHOTO_PX=2048

# Backgrounds per style the art service keeps painted ahead of the cards that
# will want them. 0 turns the pool off.
ART_POOL_SIZE=3

# How many players "Swings like" names. 0 turns the section off.
COMPS_COUNT=3

# How many cards Chromium renders at the same time.
RENDER_CONCURRENCY=2

LOG_LEVEL=INFO

# ============================================================================
# 3. The node's .env, written by make deploy
# ============================================================================
#
# This file never leaves the laptop. make deploy writes the node a .env of its
# own, mode 600, owned by the deploy user, and sends it over SSH's stdin. These
# are all the lines it holds:
#
# CARD_API_KEY      block 1's. make rotate-key replaces it in both places
# COMPOSE_PROFILES  gpu. Compose reads it, so the node runs the real models
# COMPOSE_FILE      domain mode only. Adds docker-compose.domain.yml, 80 and 443
# DOMAIN            block 1's
# BACKEND           real
# GPU_LABEL         akamai-cpu, where the api's own steps say they ran
# LLM_MODEL         deploy/models.env's. vLLM says none of these three itself
# LLM_REVISION      deploy/models.env's
# LLM_LICENSE       deploy/models.env's
# HF_TOKEN          block 1's, from this file only. One in your shell stays here
# ART_GPU           the GPU layout GPU_COUNT picks, deploy/layouts/gpu1.env or gpu2.env
# CUTOUT_GPU        the layout's: which card BiRefNet is on
# LLM_GPU           the layout's: which card vLLM is on
# LLM_RAN_ON        the layout's: the label the text step gets on the card
# LLM_GPU_MEMORY    the layout's: the fraction of its card vLLM takes
# ART_CPU_OFFLOAD   the layout's: 1 keeps FLUX's weights in RAM
#
# and each line of block 2 that this file sets, so the node runs with the
# same defaults as the laptop.
