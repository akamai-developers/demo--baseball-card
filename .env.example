# Copied to .env by `make env` and `make up-mock`. .env is gitignored.
#
# Block 1 is what you set. Block 2 is defaults: leave them. Block 3 says what
# the node's own .env holds.

# ============================================================================
# 1. What you set
# ============================================================================

# Mock mode on a laptop: nothing to set. `make up-mock` fills in CARD_API_KEY.

# The one API key. Every service checks it, vLLM included. `make env` makes it
# with openssl rand -hex 32.
CARD_API_KEY=

# The gateway's port on this machine. The mock stack binds it on 127.0.0.1.
# Change it when 8443 is taken.
GATEWAY_PORT=8443

# ---- Akamai Cloud -----------------------------------------------------------
# LINODE_TOKEN goes in your shell, not here: export LINODE_TOKEN=...

# 1 lets the deploy scripts create and destroy cloud resources.
ALLOW_CLOUD_DEPLOY=0

# How many GPUs the node has. 1 is g2-gpu-rtx4000a1-m: one 20 GB RTX 4000 Ada
# and 32 GB of RAM, and the three models share the card. 2 is
# g2-gpu-rtx4000a2-s: two cards, FLUX on one, Gemma and BiRefNet on the other.
GPU_COUNT=1

# Optional. Another RTX 4000 Ada plan with GPU_COUNT cards. Empty is the plan
# GPU_COUNT picks.
LINODE_TYPE=

# The region the node goes in.
LINODE_REGION=us-ord

# Optional. Your public IP as a CIDR, the only address allowed on port 22.
# Empty means it is detected. Pin it if you are behind CGNAT or a VPN.
ADMIN_CIDR=

# Optional. Empty is tunnel mode: only SSH is open, and the gateway is reached
# through an SSH tunnel. A hostname opens 80 and 443 so Caddy can get a Let's
# Encrypt certificate for it. Point its DNS A record at the node first.
DOMAIN=

# Optional. Only for a gated model repo. The pinned models are not gated.
HF_TOKEN=

# ============================================================================
# 2. Defaults. Nothing below needs a change to run the demo.
# ============================================================================

# How long a card and its photo stay on the node, in hours, and how often the
# sweeper looks for older ones, in seconds.
RETENTION_HOURS=24
SWEEP_EVERY_S=900

# Seconds one pipeline step may take, and the background painting.
STEP_TIMEOUT_S=180
ART_TIMEOUT_S=120

# The largest photo the api takes, in MB, and the long side it is scaled to.
MAX_UPLOAD_MB=15
MAX_PHOTO_PX=2048

# Backgrounds per style the art service keeps painted ahead of the cards that
# will want them. 0 turns the pool off.
ART_POOL_SIZE=3

# How many players "Swings like" names. 0 turns the section off.
COMPS_COUNT=3

# How many cards Chromium renders at the same time.
RENDER_CONCURRENCY=2

LOG_LEVEL=INFO

# ============================================================================
# 3. The node's .env
# ============================================================================
#
# This file never leaves the laptop. The node gets its own .env, mode 600,
# owned by the deploy user, with only what the node needs: CARD_API_KEY,
# DOMAIN and HF_TOKEN from block 1, the model pins from deploy/models.env, and
# the GPU layout GPU_COUNT picks, deploy/layouts/gpu1.env or gpu2.env: which
# card each model is on (ART_GPU, CUTOUT_GPU, LLM_GPU, LLM_RAN_ON), the
# fraction of its card vLLM takes (LLM_GPU_MEMORY) and ART_CPU_OFFLOAD.
